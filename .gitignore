# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node / frontend build
node_modules/
dist/
dist-ssr/
*.local

# JARVIS Studio runtime data (kept as empty dirs via .gitkeep)
studio/data/*.db
studio/outputs/*
!studio/outputs/.gitkeep
studio/assets/*
!studio/assets/.gitkeep
studio/loras/*
!studio/loras/.gitkeep
studio/projects/*
!studio/projects/.gitkeep
studio/.env

# Real ACS backend (adopted 2026-09-09) — runtime/output state, never source
studio/backend/outputs/*
!studio/backend/outputs/.gitkeep
studio/backend/runtime/
studio/backend/__pycache__/

# Editors / OS
.DS_Store
.vscode/
.idea/
