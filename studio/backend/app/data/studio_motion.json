{
  "label": "Motion Studio",
  "kind": "motion",
  "modes": [
    {"id": "image_motion", "label": "Image Motion", "needs": ["start_image"]},
    {"id": "talking_image", "label": "Talking Image", "needs": ["start_image", "audio"]},
    {"id": "infinite_talk", "label": "Infinite Talk", "needs": ["start_image", "audio"]},
    {"id": "character_animate", "label": "Character Animate", "needs": ["reference_image", "control_video"]}
  ],
  "reference_zones": [
    {"key": "start_image", "label": "Reference Image", "accept": "image/*"},
    {"key": "end_frame", "label": "End Frame", "accept": "image/*"},
    {"key": "reference_image", "label": "Character Photo", "accept": "image/*"},
    {"key": "control_video", "label": "Motion / Control Video", "accept": "video/*"},
    {"key": "reference_video", "label": "Scene Video (continue)", "accept": "video/*"},
    {"key": "audio", "label": "Audio (lip-sync / voz)", "accept": "audio/*"}
  ],
  "addons": [
    {"id": "end_frame", "label": "End Frame"}
  ],
  "extra_fields": [
    {"id": "intensity", "label": "Intensidade", "type": "number", "default": 0.6, "min": 0, "max": 1, "step": 0.05, "tooltip": "Intensidade do movimento aplicado."}
  ],
  "has_duration": true,
  "duration_min": 1,
  "duration_max": 60,
  "duration_default": 6,
  "has_format": true,
  "has_source_strength": true,
  "has_lora": false,
  "has_batch": false
}
