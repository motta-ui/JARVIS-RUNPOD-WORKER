# JARVIS AI STUDIO — variáveis de ambiente
# Nunca colocar chaves diretamente no código-fonte.

# --- MiniMax (adapter futuro, ver backend/app/engines/minimax) ---
MINIMAX_API_KEY=

# --- Cloud worker ---
# RUNPOD_API_KEY=      # usada por engines/cloud/providers.py (RunPodProvider) para
#                       # POST/GET/DELETE https://rest.runpod.io/v1/pods — criação e
#                       # destruição REAIS de Pods (custam dinheiro). Ligar manualmente
#                       # a um Worker já existente (Sistema -> Cloud, worker_url) NÃO
#                       # precisa desta chave — só GET /api/cloud/{provider}/pods*.
#                       # Nunca é enviada ao frontend.
# TENSORDOCK_API_KEY=   # TensorDockProvider ainda não implementado.
# VAGON_API_KEY=        # VagonProvider ainda não implementado.
